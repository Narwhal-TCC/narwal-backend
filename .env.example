# Copy to .env for local development. Local-only values - never real credentials.

# AWS / emulator endpoints (leave the endpoint URLs unset to target real AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Object storage (MinIO locally, S3 on AWS)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=narwal

# Metadata store (DynamoDB Local locally, DynamoDB on AWS)
DYNAMODB_ENDPOINT_URL=http://localhost:8000
DDB_TABLE=narwal

# Auth
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL=3600
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=admin
PLATFORM_ADMIN_ORG_ID=platform

# Model / inference
MODEL_S3_URI=s3://narwal/models/v1/model.keras
INFERENCE_TIMEOUT_SECONDS=60
