# Copy to .env for local development. Local-only values - never real credentials.

# AWS / emulator endpoints (leave the endpoint URLs unset to target real AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Object storage (MinIO locally, S3 on AWS)
S3_ENDPOINT_URL=http://localhost:9000
# Host in presigned image URLs (browser must reach it). docker-compose pins localhost:9000 for the app container.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=narwal

# Metadata store (SQLite file locally; on AWS use e.g. /data/narwal.db on EBS — see docs/aws/)
SQLITE_PATH=db/narwal.db

# Docker Compose only: entrypoint chowns the SQLite directory for ./db bind mounts (unset on EC2).
# FIX_DB_PERMISSIONS=1

# Auth
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL=3600
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=admin
PLATFORM_ADMIN_ORG_ID=platform
SEED_DEMO_USERNAME=demo
SEED_DEMO_PASSWORD=demo
SEED_DEMO_ORG_ID=demo

# Model / inference (dual-stage PyTorch)
DETECTOR_LOCAL_PATH=data/models/retinanet_melhor.pt
DETECTOR_S3_URI=s3://narwal/models/v1/retinanet_melhor.pt
CLASSIFIER_LOCAL_PATH=data/models/fusion_ghostnetv2_mobilenetv2_melhor.pt
CLASSIFIER_S3_URI=s3://narwal/models/v1/fusion_ghostnetv2_mobilenetv2_melhor.pt
INFERENCE_TIMEOUT_SECONDS=60
DETECTOR_SCORE_THRESHOLD=0.5

# YOLO + ConvNeXt pipeline (v2)
YOLO_G5_S3_URI=s3://narwal/models/v2/G5_best.pt
YOLO_A_S3_URI=s3://narwal/models/v2/yolo_a_best.pt
CONVNEXT_S3_URIS=s3://narwal/models/v2/convnext_pico_224_s42.pt,s3://narwal/models/v2/convnext_pico_224_s43.pt,s3://narwal/models/v2/convnext_pico_224_s44.pt
YOLO_G5_LOCAL_PATH=data/models/v2/G5_best.pt
YOLO_A_LOCAL_PATH=data/models/v2/yolo_a_best.pt
CONVNEXT_LOCAL_PATHS=data/models/v2/convnext_pico_224_s42.pt,data/models/v2/convnext_pico_224_s43.pt,data/models/v2/convnext_pico_224_s44.pt

# YOLO A + crop fusion v3 (main / TESTE_CONNEXT_FUSAO; reuses YOLO_A_* above)
YOLO_FUSION_V3_CLASSIFIER_S3_URI=s3://narwal/models/v3/fusao_edgenext_small_best.pt
YOLO_FUSION_V3_CLASSIFIER_LOCAL_PATH=data/models/v3/fusao_edgenext_small_best.pt
YOLO_FUSION_MOBILEVIT_CLASSIFIER_S3_URI=s3://narwal/models/v3/clf_fusao_mobilevitv2_100_s42.pt
YOLO_FUSION_MOBILEVIT_CLASSIFIER_LOCAL_PATH=data/models/v3/clf_fusao_mobilevitv2_100_s42.pt

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=10