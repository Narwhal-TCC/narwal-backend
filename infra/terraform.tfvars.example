# Copy to terraform.tfvars (gitignored) before terraform plan/apply.
# Start Lab in AWS Academy Learner Lab and use session credentials — never commit secrets.

aws_region           = "us-east-1"
project_name         = "narwal"
instance_type        = "t3.medium"
iam_instance_profile = "LabInstanceProfile"

# Keep EC2 and SQLite EBS in the same AZ (avoid volume replace on instance recreate).
availability_zone = "us-east-1a"

# SSH: EC2 key pair (public key committed under infra/keys/)
# ssh_key_name          = "narwhal-dev-keypair"
# ssh_public_key_path   = "keys/narwhal-dev-keypair.pub"
# ssh_allowed_cidr_blocks = ["203.0.113.10/32"]

# Must be globally unique; align with S3_BUCKET on the API container.
app_bucket_name = "narwal-academy-app-YOUR_UNIQUE_SUFFIX"

tags = {
  Project = "narwal"
  Managed = "terraform"
}
