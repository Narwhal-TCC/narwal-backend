# Copy to EC2 as /etc/narwal/env (gitignored on the server). Placeholders only — no real secrets.

AWS_REGION=us-east-1
# Do not set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — use LabInstanceProfile on EC2.

# Real AWS S3 (unset MinIO-style endpoints)
# S3_ENDPOINT_URL=
# S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_BUCKET=YOUR_APP_BUCKET_FROM_TERRAFORM_OUTPUT

SQLITE_PATH=/data/narwal.db

JWT_SECRET=change-me-before-public-demo
ACCESS_TOKEN_TTL=3600
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=change-me
PLATFORM_ADMIN_ORG_ID=platform
SEED_DEMO_USERNAME=demo
SEED_DEMO_PASSWORD=demo
SEED_DEMO_ORG_ID=demo

DETECTOR_S3_URI=s3://YOUR_APP_BUCKET/models/v1/retinanet_melhor.pt
CLASSIFIER_S3_URI=s3://YOUR_APP_BUCKET/models/v1/fusion_ghostnetv2_mobilenetv2_melhor.pt
YOLO_G5_S3_URI=s3://YOUR_APP_BUCKET/models/v2/G5_best.pt
YOLO_A_S3_URI=s3://YOUR_APP_BUCKET/models/v2/yolo_a_best.pt
CONVNEXT_S3_URIS=s3://YOUR_APP_BUCKET/models/v2/convnext_pico_224_s42.pt,s3://YOUR_APP_BUCKET/models/v2/convnext_pico_224_s43.pt,s3://YOUR_APP_BUCKET/models/v2/convnext_pico_224_s44.pt
YOLO_FUSION_V3_CLASSIFIER_S3_URI=s3://YOUR_APP_BUCKET/models/v3/fusao_edgenext_small_best.pt

INFERENCE_TIMEOUT_SECONDS=60
DETECTOR_SCORE_THRESHOLD=0.5

LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=10
